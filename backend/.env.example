# ===========================================
# Database (Neon PostgreSQL)
# ===========================================
# Tên database trên Neon
POSTGRES_DB=neondb
# Username của Neon
POSTGRES_USER=neondb_owner
# Password từ Neon Console (KHÔNG commit giá trị thật)
POSTGRES_PASSWORD=your-neon-password-here

# URL kết nối — lấy từ Neon Dashboard → Connection Details → Pooled connection
# Lưu ý: KHÔNG dùng ?sslmode=require với asyncpg (gây lỗi)
DATABASE_URL=postgresql+asyncpg://neondb_owner:your-password@your-host.neon.tech/neondb

# ===========================================
# Auto Migration (dev only)
# ===========================================
# Đặt true để tự chạy alembic upgrade head khi start app
AUTO_MIGRATE=false

# ===========================================
# Backend
# ===========================================
PORT=8000

# ===========================================
# Auth
# ===========================================
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=86400

# ===========================================
# CORS
# ===========================================
# Vite dev server chay o port 5173 (mac dinh Vite 8)
CORS_ORIGINS=["http://localhost:5173"]

# ===========================================
# SePay (VietQR)
# ===========================================
# API Key xac thuc webhook (cach 1)
SEPAY_API_KEY=
# Secret Key HMAC-SHA256 xac thuc webhook (cach 2, khuyen nghi)
# Neu co gia tri -> webhook bat buoc HMAC, khong dung API Key
SEPAY_WEBHOOK_SECRET=
# Bearer token cho SePay API v2 (doi soat giao dich)
SEPAY_API_TOKEN=
# Sandbox: https://userapi-sandbox.sepay.vn/v2
SEPAY_API_BASE_URL=https://userapi.sepay.vn/v2
# So tai khoan nhan tien (hoac so VA) - xem my.sepay.vn > Tai khoan ngan hang
SEPAY_BANK_ACCOUNT=
# Ma ngan hang ngan gon trong vietqr.app/banks.json (VD: VietinBank, MB, ACB)
SEPAY_BANK_NAME=
# Base URL sinh anh QR VietQR
SEPAY_QR_BASE_URL=https://vietqr.app/img
# VietinBank (ca nhan / ho kinh doanh) BAT BUOC noi dung chuyen khoan chua "SEVQR"
# - thieu chuoi nay giao dich khong duoc SePay day ve webhook. Bo trong neu
# ngan hang khong yeu cau (VD Vietcombank, ACB, MBBank).
SEPAY_QR_CONTENT_PREFIX=
# Ma thanh toan (order_code): tien to + do dai hau to (chu so).
# PHAI KHOP voi mau ma khai bao o SePay dashboard
# (Cong ty -> Cau hinh chung -> Cau truc ma thanh toan: tien to "ORD", hau to 12 so).
# Sai => SePay khong trich duoc `code` => KHONG gui webhook => mat tien.
SEPAY_PAYMENT_CODE_PREFIX=ORD
SEPAY_PAYMENT_CODE_SUFFIX_LENGTH=12

# ===========================================
# Cloudinary (https://console.cloudinary.com/)
# ===========================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=cosme_shop_unsigned
CLOUDINARY_FOLDER=cosme-shop
CLOUDINARY_MAX_FILE_SIZE=5242880
